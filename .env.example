# Public browser credentials. Use the modern Supabase publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only credentials. Never prefix the secret with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Keeps the full website private until launch. Set this in Vercel only.
SITE_PASSWORD=

# Optional HTML verification token from Google Search Console.
GOOGLE_SITE_VERIFICATION=

# Launch and signed customer links. Generate long random secrets.
SITE_LIVE=false
APP_URL=https://symmetrywales.com
LINK_SIGNING_SECRET=
CRON_SECRET=

# Stripe: start with test keys. Checkout saves a card, with no deposit.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CARD_CHARGES_ENABLED=false

# Transactional emails; EMAIL_FROM must use a verified sending domain.
RESEND_API_KEY=
EMAIL_FROM=

# Optional SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Optional web push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:info@symmetrywales.com

# Optional Apple Wallet signing certificates (PEM; literal \n supported)
APPLE_PASS_CERT=
APPLE_PASS_KEY=
APPLE_PASS_KEY_PASSWORD=
APPLE_WWDR_CERT=
APPLE_TEAM_ID=
APPLE_PASS_TYPE_ID=

# Optional Google Wallet approved Generic class and service account
GOOGLE_WALLET_CLASS_ID=
GOOGLE_WALLET_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY=

# Explicit launch switches. Enable only in the intended test/live environment.
BOOKINGS_ENABLED=false
NOTIFICATIONS_ENABLED=false
